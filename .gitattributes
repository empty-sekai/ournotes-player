# Normalize text files to LF on commit and in the working tree.
* text=auto eol=lf

*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.glsl      text eol=lf
*.sh        text eol=lf

*.png       binary
*.jpg       binary
*.webp      binary
*.flac      binary
*.m4a       binary
*.ogg       binary
*.opus      binary
