# Text files are stored with LF and checked out with LF on every platform.
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Binary: never normalized.
*.png   binary
*.jpg   binary
*.webp  binary
*.tgz   binary
*.zip   binary
