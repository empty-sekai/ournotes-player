{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/empty-sekai/ournotes-player/main/schema/manifest.schema.json",
  "title": "Chart manifest (charts/<musicId>_<difficulty>.json, or charts/<region>/<musicId>_<difficulty>.json)",
  "description": "The logical files of one chart and where their bytes are. See docs/data-format.md.",
  "type": "object",
  "required": ["format", "musicId", "difficulty", "files"],
  "properties": {
    "format": { "enum": [2, 3], "description": "3: the current form (files may be encoded assets); 2: the older form, every asset stored as it is." },
    "musicId": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "string", "pattern": "^[a-z]+$" },
    "chart": { "$ref": "#/$defs/chart" },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/regionId" }, "minItems": 1 },
    "audio": { "type": "boolean" },
    "audioFormat": { "enum": ["aac", "flac"] },
    "flows": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "quality": { "enum": [0, 1, 2] },
    "options": {
      "type": "object",
      "description": "Optional: Live option name -> the values the files support (options that select files).",
      "properties": {
        "LiveQuality": { "type": "array", "items": { "enum": [0, 1, 2] }, "minItems": 1 }
      },
      "additionalProperties": { "type": "array", "minItems": 1 }
    },
    "files": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_][^\\\\]*$" },
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/$defs/whole" }, { "$ref": "#/$defs/encoded" }, { "$ref": "#/$defs/parts" }]
      }
    }
  },
  "$defs": {
    "language": { "type": "string", "minLength": 1 },
    "regionId": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "asset": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$" },
    "encodedAsset": {
      "description": "An asset stored gzip- or brotli-encoded: the SHA-256 of its decoded bytes, the logical file's extension, then .gz or .br.",
      "type": "string",
      "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+\\.(gz|br)$"
    },
    "size": { "description": "The byte count of the file (decoded).", "type": "integer", "minimum": 0 },
    "stored": { "description": "The byte count of an encoded asset as stored (less than size).", "type": "integer", "minimum": 0 },
    "whole": {
      "type": "object",
      "required": ["asset", "size"],
      "additionalProperties": false,
      "properties": { "asset": { "$ref": "#/$defs/asset" }, "size": { "$ref": "#/$defs/size" } }
    },
    "encoded": {
      "type": "object",
      "required": ["asset", "size", "stored"],
      "additionalProperties": false,
      "properties": {
        "asset": { "$ref": "#/$defs/encodedAsset" },
        "size": { "$ref": "#/$defs/size" },
        "stored": { "$ref": "#/$defs/stored" }
      }
    },
    "parts": {
      "type": "object",
      "required": ["parts", "size"],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/asset" }, { "$ref": "#/$defs/size" }],
                "minItems": 3,
                "maxItems": 3
              },
              {
                "type": "array",
                "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/encodedAsset" }, { "$ref": "#/$defs/size" },
                                { "$ref": "#/$defs/stored" }],
                "minItems": 4,
                "maxItems": 4
              }
            ]
          }
        },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "chart": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "language": { "$ref": "#/$defs/language" },
        "titles": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "string" } },
        "bands": { "type": "array", "items": { "type": "string" } },
        "bandNames": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "bandIds": { "type": "array", "items": { "type": "integer" } },
        "stageBand": { "type": "integer" },
        "level": { "type": "integer" },
        "displayLevel": { "type": "number" },
        "notes": { "type": "integer", "minimum": 0 },
        "fullComboCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "sortOrder": { "type": "integer" }
      }
    }
  }
}
