{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://raw.githubusercontent.com/empty-sekai/ournotes-player/main/schema/story-language.schema.json",
  "title": "Story UI language settings",
  "required": [
    "code",
    "mode",
    "field",
    "lineSpacing",
    "fontNames",
    "additionalFontNames",
    "materialTypes",
    "fontSwap"
  ],
  "properties": {
    "code": {
      "enum": [
        "ja",
        "en",
        "zh-Hant",
        "zh-Hans",
        "ko"
      ]
    },
    "mode": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "field": {
      "enum": [
        "japanese",
        "english",
        "traditionalChinese",
        "simplifiedChinese",
        "korean"
      ]
    },
    "lineSpacing": {
      "type": "number"
    },
    "fontNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "additionalFontNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materialTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fontSwap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
