{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/empty-sekai/ournotes-player/main/schema/live-audio.schema.json",
  "title": "Live sounds (audio/live-audio.json)",
  "description": "The sounds of one live: cues and their waveform layers, category volumes, ducking, and the sound ids of the music, note sound effects, live sound effects and voices. Only the keys the player reads are described. See docs/data-format.md.",
  "type": "object",
  "required": ["sounds", "categories", "react", "music", "noteSe", "liveSe"],
  "properties": {
    "sounds": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/sound" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "react": { "type": "array", "items": { "$ref": "#/$defs/react" } },
    "music": {
      "type": "object",
      "required": ["soundId"],
      "properties": { "soundId": { "$ref": "#/$defs/soundId" } }
    },
    "noteSe": {
      "type": "object",
      "required": ["types", "volumes", "mutes"],
      "properties": {
        "types": { "$ref": "#/$defs/byType", "additionalProperties": { "$ref": "#/$defs/soundId" } },
        "volumes": { "$ref": "#/$defs/byType", "additionalProperties": { "type": "number", "minimum": 0 } },
        "mutes": { "$ref": "#/$defs/byType", "additionalProperties": { "type": "boolean" } },
        "patternId": { "type": "integer", "minimum": 1, "description": "Optional: the note sound set of types (default 1)." },
        "groups": {
          "type": "object",
          "description": "Optional: note sound set id -> LiveNoteSeType -> sound id (the NoteSePatternId / individual note sound options).",
          "propertyNames": { "pattern": "^[1-9][0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/byType", "additionalProperties": { "$ref": "#/$defs/soundId" } }
        }
      }
    },
    "liveSe": { "$ref": "#/$defs/byType", "additionalProperties": { "$ref": "#/$defs/soundId" } },
    "voice": {
      "type": "object",
      "properties": {
        "startVoiceSoundId": { "$ref": "#/$defs/optionalSoundId" },
        "clearVoiceSoundId": { "$ref": "#/$defs/optionalSoundId" },
        "fullComboVoiceSoundId": { "$ref": "#/$defs/optionalSoundId" },
        "allPerfectVoiceSoundId": { "$ref": "#/$defs/optionalSoundId" }
      }
    }
  },
  "$defs": {
    "soundId": { "type": "integer", "minimum": 1 },
    "optionalSoundId": { "type": "integer", "minimum": -1 },
    "byType": { "type": "object", "propertyNames": { "pattern": "^[0-9]+$" } },
    "sound": {
      "type": "object",
      "required": ["sheet", "cue", "category", "categories", "volume", "row", "layers"],
      "properties": {
        "sheet": { "type": "string" },
        "cue": { "type": "string" },
        "category": { "type": "integer" },
        "categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "volume": { "type": "number", "minimum": 0 },
        "row": {
          "type": "object",
          "required": ["_isRandomPitch"],
          "properties": { "_isRandomPitch": { "const": false } }
        },
        "layers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layer" } }
      }
    },
    "layer": {
      "type": "object",
      "required": ["file", "sampleRate", "samples", "loopFlag", "loopStart", "loopEnd", "volume"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9_][^\\\\]*\\.(flac|m4a)$" },
        "sampleRate": { "const": 48000 },
        "channels": { "type": "integer", "minimum": 1 },
        "samples": { "type": "integer", "minimum": 1 },
        "loopFlag": { "type": "integer" },
        "loopStart": { "type": ["integer", "null"], "minimum": 0 },
        "loopEnd": { "type": ["integer", "null"], "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "encoderDelay": { "type": "integer", "minimum": 0 }
      }
    },
    "react": {
      "type": "object",
      "required": ["src", "dest", "level", "decrementMs", "incrementMs", "holdMs"],
      "properties": {
        "src": { "type": "string" },
        "dest": { "type": "string" },
        "level": { "type": "number", "minimum": 0 },
        "decrementMs": { "type": "number", "minimum": 0 },
        "incrementMs": { "type": "number", "minimum": 0 },
        "holdMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
