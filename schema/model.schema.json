{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/empty-sekai/ournotes-player/main/schema/model.schema.json",
  "title": "Model manifest (models/<id>.json)",
  "description": "The logical files of one Live2D model and where their bytes are; the file entries are those of a chart manifest. See docs/data-format.md.",
  "type": "object",
  "required": ["format", "id", "files"],
  "properties": {
    "format": { "enum": [2, 3], "description": "3: the current form (files may be encoded assets; model.json of format 2); 2: the older form." },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "key": { "type": "string" },
    "model": {
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "canvas": { "$ref": "#/$defs/canvas" },
        "textures": { "type": "integer", "minimum": 0 },
        "nodes": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer" },
        "names": { "$ref": "#/$defs/names" },
        "label": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_][^\\\\]*$" },
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/$defs/whole" }, { "$ref": "#/$defs/encoded" }, { "$ref": "#/$defs/parts" }]
      }
    }
  },
  "$defs": {
    "names": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "pixelsPerUnit": { "type": "number" },
        "originX": { "type": "number" },
        "originY": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "mocVersion": { "type": "integer" }
      }
    },
    "asset": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$" },
    "encodedAsset": {
      "description": "An asset stored gzip- or brotli-encoded: the SHA-256 of its decoded bytes, the logical file's extension, then .gz or .br.",
      "type": "string",
      "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+\\.(gz|br)$"
    },
    "size": { "description": "The byte count of the file (decoded).", "type": "integer", "minimum": 0 },
    "stored": { "description": "The byte count of an encoded asset as stored (less than size).", "type": "integer", "minimum": 0 },
    "whole": {
      "type": "object",
      "required": ["asset", "size"],
      "additionalProperties": false,
      "properties": { "asset": { "$ref": "#/$defs/asset" }, "size": { "$ref": "#/$defs/size" } }
    },
    "encoded": {
      "type": "object",
      "required": ["asset", "size", "stored"],
      "additionalProperties": false,
      "properties": {
        "asset": { "$ref": "#/$defs/encodedAsset" },
        "size": { "$ref": "#/$defs/size" },
        "stored": { "$ref": "#/$defs/stored" }
      }
    },
    "parts": {
      "type": "object",
      "required": ["parts", "size"],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/asset" }, { "$ref": "#/$defs/size" }],
                "minItems": 3,
                "maxItems": 3
              },
              {
                "type": "array",
                "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/encodedAsset" }, { "$ref": "#/$defs/size" },
                                { "$ref": "#/$defs/stored" }],
                "minItems": 4,
                "maxItems": 4
              }
            ]
          }
        },
        "size": { "$ref": "#/$defs/size" }
      }
    }
  }
}
