{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/empty-sekai/ournotes-player/main/schema/model.schema.json",
  "title": "Model manifest (models/<id>.json)",
  "description": "The logical files of one Live2D model and where their bytes are; the file entries are those of a chart manifest. See docs/data-format.md.",
  "type": "object",
  "required": ["format", "id", "files"],
  "properties": {
    "format": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "key": { "type": "string" },
    "model": {
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "canvas": { "$ref": "#/$defs/canvas" },
        "textures": { "type": "integer", "minimum": 0 },
        "nodes": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer" },
        "names": { "$ref": "#/$defs/names" },
        "label": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_][^\\\\]*$" },
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/$defs/whole" }, { "$ref": "#/$defs/parts" }]
      }
    }
  },
  "$defs": {
    "names": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "pixelsPerUnit": { "type": "number" },
        "originX": { "type": "number" },
        "originY": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "mocVersion": { "type": "integer" }
      }
    },
    "asset": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$" },
    "size": { "type": "integer", "minimum": 0 },
    "whole": {
      "type": "object",
      "required": ["asset", "size"],
      "additionalProperties": false,
      "properties": { "asset": { "$ref": "#/$defs/asset" }, "size": { "$ref": "#/$defs/size" } }
    },
    "parts": {
      "type": "object",
      "required": ["parts", "size"],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/asset" }, { "$ref": "#/$defs/size" }],
            "minItems": 3,
            "maxItems": 3
          }
        },
        "size": { "$ref": "#/$defs/size" }
      }
    }
  }
}
